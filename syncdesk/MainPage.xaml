<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="syncdesk.MainPage"
             Title="SyncDesk Inventory">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="⟳" Clicked="OnRefreshClicked" />
        <ToolbarItem Text="🔔" Clicked="OnNotificationsClicked" />
    </ContentPage.ToolbarItems>

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <Label Text="Warehouse Stock" 
                   FontSize="24" 
                   FontAttributes="Bold" />

            <SearchBar x:Name="ProductSearchBar" 
                   Placeholder="Search by name or SKU..." 
                   TextChanged="OnSearchBarTextChanged" />

            <CollectionView x:Name="InventoryList" SelectionMode="Single" SelectionChanged="OnProductSelected">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,5,0,5" Padding="15" StrokeShape="8" BackgroundColor="#f1f5f9" Stroke="Transparent">
                            <VerticalStackLayout>
                                <Label Text="{Binding product_name}" FontSize="18" FontAttributes="Bold" TextColor="#0f172a" />
                                <Label Text="{Binding sku, StringFormat='SKU: {0}'}" FontSize="14" TextColor="#64748b" />

                                <HorizontalStackLayout Spacing="10" Margin="0,5,0,0">
                                    <Label Text="{Binding stock, StringFormat='Stock: {0}'}" FontSize="14" FontAttributes="Bold" TextColor="#14b8a6" />
                                    <Label Text="{Binding warehouse_location}" FontSize="14" TextColor="#64748b" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>