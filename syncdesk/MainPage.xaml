<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="syncdesk.MainPage"
             Title="SyncDesk Inventory"
             BackgroundColor="{AppThemeBinding Light=#f5f4f0, Dark=Black}">

    <Shell.TitleView>
        <Grid ColumnDefinitions="*, Auto, Auto, Auto, Auto" Padding="0, 0, 15, 0" BackgroundColor="{AppThemeBinding Light=White, Dark=#121212}">
            <Label Text="SyncDesk" FontSize="20" FontAttributes="Bold" VerticalOptions="Center" TextColor="{AppThemeBinding Light=Black, Dark=White}" />
            <Label x:Name="LastUpdatedLabel" Text="updated 0s ago" FontSize="12" TextColor="Gray" VerticalOptions="Center" Margin="0, 0, 10, 0" Grid.Column="1" />
            <Button Text="⟳" Clicked="OnRefreshClicked" BackgroundColor="Transparent" TextColor="{AppThemeBinding Light=Black, Dark=White}" FontSize="20" Grid.Column="2" Padding="5" />
            <Grid Grid.Column="3" WidthRequest="40" HeightRequest="40" Margin="0,0,5,0">
                <Button Text="🔔" Clicked="OnNotificationsClicked" BackgroundColor="Transparent" TextColor="{AppThemeBinding Light=Black, Dark=White}" FontSize="20" Padding="5" />
                <Border x:Name="NotifBadgeFrame" IsVisible="False" BackgroundColor="#c0392b" StrokeThickness="0" StrokeShape="RoundRectangle 10" HeightRequest="20" WidthRequest="20" HorizontalOptions="End" VerticalOptions="Start" Padding="0">
                    <Label x:Name="NotifCountLabel" Text="0" TextColor="White" FontSize="10" HorizontalOptions="Center" VerticalOptions="Center" FontAttributes="Bold"/>
                </Border>
            </Grid>

            <Button Text="⚙️" Clicked="OnSettingsClicked" BackgroundColor="Transparent" TextColor="{AppThemeBinding Light=Black, Dark=White}" FontSize="20" Grid.Column="4" Padding="5" />
        </Grid>
    </Shell.TitleView>

    <Grid RowDefinitions="Auto, *">

        <VerticalStackLayout x:Name="TopSearchBarArea" Grid.Row="0" Padding="20,20,20,10" ZIndex="2">
            <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10">

                <Border Grid.Column="0" Stroke="{AppThemeBinding Light=#dedad4, Dark=#333333}" StrokeShape="RoundRectangle 8" BackgroundColor="{AppThemeBinding Light=White, Dark=#1a1a1a}" Padding="0">
                    <SearchBar x:Name="ProductSearchBar" Placeholder="Search products" TextChanged="OnSearchBarTextChanged" Focused="OnSearchBarFocused" Unfocused="OnSearchBarUnfocused" SearchButtonPressed="OnSearchButtonPressed" BackgroundColor="Transparent" TextColor="{AppThemeBinding Light=Black, Dark=White}" />
                </Border>

                <Button Grid.Column="1" Text="Search" BackgroundColor="#2D8F92" TextColor="White" CornerRadius="8" Padding="15,0" FontAttributes="Bold" Clicked="OnSearchButtonClicked" />

            </Grid>
        </VerticalStackLayout>
        <ScrollView Grid.Row="1" ZIndex="1">
            <VerticalStackLayout Padding="20,0,20,20" Spacing="20">

                <VerticalStackLayout x:Name="DashboardView" IsVisible="True" Spacing="20">

                    <Border Padding="15" StrokeShape="RoundRectangle 16" BackgroundColor="{AppThemeBinding Light=White, Dark=#1a1a1a}" Stroke="{AppThemeBinding Light=#dedad4, Dark=#333333}">
                        <VerticalStackLayout Spacing="15">
                            <Grid>
                                <Label Text="RECENTLY UPDATED" FontSize="12" FontAttributes="Bold" TextColor="Gray" VerticalOptions="Center"/>
                                <Label Text="See All" HorizontalOptions="End" TextColor="#2D8F92" FontAttributes="Bold" FontSize="12" VerticalOptions="Center">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnSeeAllRecentClicked" />
                                    </Label.GestureRecognizers>
                                </Label>
                            </Grid>

                            <CollectionView x:Name="RecentProductsList">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="*, Auto, Auto" Padding="0,10">
                                            <VerticalStackLayout Grid.Column="0" VerticalOptions="Center">
                                                <Label Text="{Binding product_name}" FontSize="15" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#1a1916, Dark=White}" />
                                                <Label Text="{Binding sku}" FontSize="12" TextColor="Gray" />
                                            </VerticalStackLayout>

                                            <Label Grid.Column="1" Text="{Binding stock, StringFormat='Qty: {0}'}" FontSize="14" FontAttributes="Bold" TextColor="{AppThemeBinding Light=Black, Dark=White}" VerticalOptions="Center" Margin="0,0,15,0" />

                                            <Button Grid.Column="2" Text="View" BackgroundColor="{AppThemeBinding Light=#eef2ff, Dark=#2D8F92}" TextColor="{AppThemeBinding Light=#2D8F92, Dark=White}" CornerRadius="5" Padding="15,5" CommandParameter="{Binding .}" Clicked="OnProductViewClicked" FontAttributes="Bold" HeightRequest="35"/>
                                        </Grid>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </VerticalStackLayout>
                    </Border>

                    <Border Padding="15" StrokeShape="RoundRectangle 16" BackgroundColor="{AppThemeBinding Light=White, Dark=#1a1a1a}" Stroke="{AppThemeBinding Light=#dedad4, Dark=#333333}">
                        <VerticalStackLayout Spacing="15">
                            <Grid>
                                <Label Text="AUDIT LOGS" FontSize="12" FontAttributes="Bold" TextColor="Gray" VerticalOptions="Center"/>
                                <Label Text="See All" HorizontalOptions="End" TextColor="#2D8F92" FontAttributes="Bold" FontSize="12" VerticalOptions="Center">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnSeeAllLogsClicked" />
                                    </Label.GestureRecognizers>
                                </Label>
                            </Grid>

                            <CollectionView x:Name="DashboardAuditLogsList">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="*, Auto, Auto" Padding="0,10">
                                            <VerticalStackLayout Grid.Column="0" VerticalOptions="Center">
                                                <Label Text="{Binding action}" FontSize="15" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#1a1916, Dark=White}" />
                                                <Label Text="{Binding product_name}" FontSize="12" TextColor="Gray" />
                                            </VerticalStackLayout>

                                            <Label Grid.Column="1" Text="{Binding date}" FontSize="13" TextColor="{AppThemeBinding Light=#2D8F92, Dark=#64ffda}" VerticalOptions="Center" Margin="0,0,15,0" />

                                            <Button Grid.Column="2" Text="View" BackgroundColor="{AppThemeBinding Light=#eef2ff, Dark=#2D8F92}" TextColor="{AppThemeBinding Light=#2D8F92, Dark=White}" CornerRadius="5" Padding="15,5" FontAttributes="Bold" HeightRequest="35" CommandParameter="{Binding .}" Clicked="OnLogViewClicked"/>
                                        </Grid>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout x:Name="ProductDetailsView" IsVisible="False" Spacing="15">
                    <Button Text="← Back to Dashboard" HorizontalOptions="Start" BackgroundColor="Transparent" TextColor="#2D8F92" Clicked="OnBackToDashboardClicked" Padding="0" FontAttributes="Bold" />

                    <Border Padding="15" StrokeShape="RoundRectangle 12" BackgroundColor="{AppThemeBinding Light=White, Dark=#1a1a1a}" Stroke="{AppThemeBinding Light=#dedad4, Dark=#333333}">
                        <Grid ColumnDefinitions="100, *" ColumnSpacing="15">
                            <BoxView Grid.Column="0" Color="{AppThemeBinding Light=#e0e0e0, Dark=#333333}" HeightRequest="100" CornerRadius="5" />
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Text="Product:" FontSize="12" TextColor="Gray" />
                                <Label x:Name="DetailName" Text="Widget" FontSize="16" FontAttributes="Bold" TextColor="{AppThemeBinding Light=Black, Dark=White}" />
                                <Label x:Name="DetailSku" Text="SKU" FontSize="12" TextColor="Gray" Margin="0,5,0,0" />
                                <Label x:Name="DetailLocation" Text="Location" FontSize="12" TextColor="Gray" />
                                <Label x:Name="DetailStock" Text="Qty" FontSize="14" FontAttributes="Bold" TextColor="{AppThemeBinding Light=Black, Dark=White}" Margin="0,5,0,0" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <Border Padding="20" StrokeShape="RoundRectangle 12" BackgroundColor="{AppThemeBinding Light=#e8f5e9, Dark=#1a2a2a}" Stroke="#2D8F92">
                        <VerticalStackLayout Spacing="15">
                            <Label Text="Stock Check / Update" FontSize="16" FontAttributes="Bold" TextColor="{AppThemeBinding Light=Black, Dark=White}" />
                            <Button Text="Update Stock" BackgroundColor="#2D8F92" TextColor="White" CornerRadius="8" HeightRequest="45" Clicked="OnUpdateStockClicked" FontAttributes="Bold" />
                        </VerticalStackLayout>
                    </Border>

                    <Border BackgroundColor="{AppThemeBinding Light=#f8f9fa, Dark=#121212}" Stroke="{AppThemeBinding Light=#dedad4, Dark=#333333}" StrokeShape="RoundRectangle 12" Padding="20,10">
                        <VerticalStackLayout>
                            <Grid>
                                <Label Text="Recent Item Logs" FontSize="16" FontAttributes="Bold" VerticalOptions="Center" TextColor="{AppThemeBinding Light=Black, Dark=White}" />                                
                            </Grid>
                            <CollectionView x:Name="ItemLogsList" IsVisible="False" HeightRequest="100" Margin="0,10,0,0">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="*, Auto" Padding="0,5">
                                            <Label Text="{Binding action}" FontSize="13" TextColor="Gray" />
                                            <Label Text="{Binding date}" FontSize="13" TextColor="{AppThemeBinding Light=Black, Dark=White}" FontAttributes="Bold" Grid.Column="1" />
                                        </Grid>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </VerticalStackLayout>
                    </Border>

                </VerticalStackLayout>

                <VerticalStackLayout x:Name="LogDetailsView" IsVisible="False" Spacing="15">
                    <Button Text="← Back to Logs" HorizontalOptions="Start" BackgroundColor="Transparent" TextColor="#2D8F92" Clicked="OnSeeAllLogsClicked" Padding="0" FontAttributes="Bold" />

                    <Border Padding="15" StrokeShape="RoundRectangle 12" BackgroundColor="{AppThemeBinding Light=White, Dark=#1a1a1a}" Stroke="{AppThemeBinding Light=#dedad4, Dark=#333333}">
                        <VerticalStackLayout Spacing="10">
                            <Label Text="Audit Log Details" FontSize="18" FontAttributes="Bold" TextColor="{AppThemeBinding Light=Black, Dark=White}" />
                            <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#e0e0e0, Dark=#333333}" />

                            <Label x:Name="LogDetailAction" Text="Action" FontSize="16" FontAttributes="Bold" TextColor="{AppThemeBinding Light=Black, Dark=White}" />
                            <Label x:Name="LogDetailDate" Text="Date &amp; Time" FontSize="13" TextColor="{AppThemeBinding Light=#2D8F92, Dark=#64ffda}" />
                            <Label x:Name="LogDetailUser" Text="User" FontSize="14" TextColor="Gray" />
                            <Label x:Name="LogDetailInfo" Text="Details" FontSize="14" TextColor="{AppThemeBinding Light=Black, Dark=White}" Margin="0,10,0,10" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Padding="15" StrokeShape="RoundRectangle 12" BackgroundColor="{AppThemeBinding Light=#f8f9fa, Dark=#121212}" Stroke="{AppThemeBinding Light=#dedad4, Dark=#333333}">
                        <Grid ColumnDefinitions="*, Auto">
                            <VerticalStackLayout Grid.Column="0" VerticalOptions="Center">
                                <Label Text="Associated Product:" FontSize="12" TextColor="Gray" />
                                <Label x:Name="LogDetailProduct" Text="Product Name" FontSize="16" FontAttributes="Bold" TextColor="{AppThemeBinding Light=Black, Dark=White}" />
                                <Label x:Name="LogDetailSku" Text="SKU" FontSize="12" TextColor="Gray" />
                            </VerticalStackLayout>
                            <Button Grid.Column="1" Text="View Product" BackgroundColor="#2D8F92" TextColor="White" CornerRadius="8" Padding="15,5" Clicked="OnViewProductFromLogClicked" FontAttributes="Bold" VerticalOptions="Center" />
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout x:Name="NotificationsView" IsVisible="False" Spacing="15">
                    <Button Text="← Back to Dashboard" HorizontalOptions="Start" BackgroundColor="Transparent" TextColor="#2D8F92" Clicked="OnBackToDashboardClicked" Padding="0" FontAttributes="Bold" />

                    <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                        <Label Text="Notifications" FontSize="20" FontAttributes="Bold" TextColor="{AppThemeBinding Light=Black, Dark=White}" VerticalOptions="Center"/>
                        <Button Grid.Column="1" Text="Mark All Read" BackgroundColor="Transparent" TextColor="#2D8F92" FontAttributes="Bold" Clicked="OnMarkAllReadClicked" Padding="0" />
                    </Grid>

                    <Grid ColumnDefinitions="Auto, Auto, Auto, *">
                        <Picker x:Name="NotificationFilterPicker" Title="Filter Status" SelectedIndex="0" SelectedIndexChanged="OnNotificationFilterChanged" WidthRequest="150" Grid.Column="0" BackgroundColor="{AppThemeBinding Light=White, Dark=#1a1a1a}" TextColor="{AppThemeBinding Light=Black, Dark=White}">
                            <Picker.Items>
                                <x:String>All</x:String>
                                <x:String>Unread</x:String>
                                <x:String>Read</x:String>
                            </Picker.Items>
                        </Picker>

                        <Button Text="Mark Selected Read" BackgroundColor="#2D8F92" TextColor="White" CornerRadius="5" Padding="15,5" Grid.Column="1" Margin="10,0,0,0" Clicked="OnMarkSelectedReadClicked" FontAttributes="Bold" />

                        <Button Text="Delete Selected" BackgroundColor="#c0392b" TextColor="White" CornerRadius="5" Padding="15,5" Grid.Column="2" Margin="10,0,0,0" Clicked="OnDeleteSelectedClicked" FontAttributes="Bold" />
                    </Grid>

                    <CollectionView x:Name="NotificationsList">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,10" Padding="15" StrokeShape="RoundRectangle 8" BackgroundColor="{AppThemeBinding Light=White, Dark=#1a1a1a}" Stroke="{AppThemeBinding Light=#dedad4, Dark=#333333}">
                                    <Grid ColumnDefinitions="Auto, *, Auto, Auto" ColumnSpacing="15">
                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalOptions="Center" Color="#2D8F92" />

                                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                            <Label Text="{Binding Title}" FontSize="15" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#1a1916, Dark=White}" />
                                            <Label Text="{Binding ProductName}" FontSize="13" TextColor="#2D8F92" FontAttributes="Bold" IsVisible="{Binding HasProduct}" />
                                            <Label Text="{Binding Description}" FontSize="12" TextColor="Gray" />
                                            <Label Text="{Binding Date}" FontSize="11" TextColor="Gray" Margin="0,5,0,0"/>
                                        </VerticalStackLayout>

                                        <Label Grid.Column="2" Text="{Binding ReadStatusText}" FontSize="12" FontAttributes="Bold" TextColor="Gray" VerticalOptions="Center" Margin="0,0,10,0"/>

                                        <Button Grid.Column="3" Text="View" BackgroundColor="{AppThemeBinding Light=#eef2ff, Dark=#2D8F92}" TextColor="{AppThemeBinding Light=#2D8F92, Dark=White}" CornerRadius="5" Padding="15,5" CommandParameter="{Binding .}" Clicked="OnNotificationViewClicked" FontAttributes="Bold" VerticalOptions="Center" HeightRequest="35" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

                <VerticalStackLayout x:Name="AllProductsView" IsVisible="False" Spacing="15">
                    <Button Text="← Back to Dashboard" HorizontalOptions="Start" BackgroundColor="Transparent" TextColor="#2D8F92" Clicked="OnBackToDashboardClicked" Padding="0" FontAttributes="Bold" />
                    <Label Text="Inventory Items" FontSize="20" FontAttributes="Bold" TextColor="{AppThemeBinding Light=Black, Dark=White}" />

                    <CollectionView x:Name="FullInventoryList">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,10" Padding="15" StrokeShape="RoundRectangle 8" BackgroundColor="{AppThemeBinding Light=White, Dark=#1a1a1a}" Stroke="{AppThemeBinding Light=#dedad4, Dark=#333333}">
                                    <Grid ColumnDefinitions="*, Auto, Auto">
                                        <VerticalStackLayout Grid.Column="0" VerticalOptions="Center">
                                            <Label Text="{Binding product_name}" FontSize="16" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#1a1916, Dark=White}" />
                                            <Label Text="{Binding sku}" FontSize="12" TextColor="Gray" />
                                        </VerticalStackLayout>
                                        <Label Grid.Column="1" Text="{Binding stock, StringFormat='Qty: {0}'}" FontSize="14" FontAttributes="Bold" TextColor="{AppThemeBinding Light=Black, Dark=White}" VerticalOptions="Center" Margin="0,0,15,0" />
                                        <Button Grid.Column="2" Text="View" BackgroundColor="{AppThemeBinding Light=#eef2ff, Dark=#2D8F92}" TextColor="{AppThemeBinding Light=#2D8F92, Dark=White}" CornerRadius="5" Padding="15,5" CommandParameter="{Binding .}" Clicked="OnProductViewClicked" FontAttributes="Bold" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

                <VerticalStackLayout x:Name="AllLogsView" IsVisible="False" Spacing="15">
                    <Button Text="← Back to Dashboard" HorizontalOptions="Start" BackgroundColor="Transparent" TextColor="#2D8F92" Clicked="OnBackToDashboardClicked" Padding="0" FontAttributes="Bold" />
                    <Label Text="Complete Audit Logs" FontSize="20" FontAttributes="Bold" TextColor="{AppThemeBinding Light=Black, Dark=White}" />

                    <CollectionView x:Name="FullLogsList">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,10" Padding="15" StrokeShape="RoundRectangle 8" BackgroundColor="{AppThemeBinding Light=White, Dark=#1a1a1a}" Stroke="{AppThemeBinding Light=#dedad4, Dark=#333333}">
                                    <Grid ColumnDefinitions="*, Auto">
                                        <VerticalStackLayout Grid.Column="0" VerticalOptions="Center">
                                            <Label Text="{Binding action}" FontSize="15" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#1a1916, Dark=White}" />
                                            <Label Text="{Binding product_name}" FontSize="12" TextColor="Gray" />
                                        </VerticalStackLayout>
                                        <Label Grid.Column="1" Text="{Binding date}" FontSize="13" TextColor="{AppThemeBinding Light=#2D8F92, Dark=#64ffda}" VerticalOptions="Center" />
                                        <Button Grid.Column="2" Text="View" BackgroundColor="{AppThemeBinding Light=#eef2ff, Dark=#2D8F92}" TextColor="{AppThemeBinding Light=#2D8F92, Dark=White}" CornerRadius="5" Padding="15,5" FontAttributes="Bold" HeightRequest="35" CommandParameter="{Binding .}" Clicked="OnLogViewClicked"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <VerticalStackLayout x:Name="SettingsView" IsVisible="False" Spacing="15">
            <Button Text="← Back to Dashboard" HorizontalOptions="Start" BackgroundColor="Transparent" TextColor="#2D8F92" Clicked="OnBackToDashboardClicked" Padding="0" FontAttributes="Bold" />

            <Label Text="Settings" FontSize="20" FontAttributes="Bold" TextColor="{AppThemeBinding Light=Black, Dark=White}" />

            <Border Padding="15" StrokeShape="RoundRectangle 12" BackgroundColor="{AppThemeBinding Light=White, Dark=#1a1a1a}" Stroke="{AppThemeBinding Light=#dedad4, Dark=#333333}">
                <VerticalStackLayout Spacing="15">

                    <Label Text="Appearance" FontSize="16" FontAttributes="Bold" TextColor="{AppThemeBinding Light=Black, Dark=White}" />
                    <Grid ColumnDefinitions="*, Auto">
                        <Label Text="Theme Mode" VerticalOptions="Center" TextColor="Gray" />
                        <Picker x:Name="ThemePicker" Grid.Column="1" WidthRequest="150" SelectedIndexChanged="OnThemeChanged" BackgroundColor="{AppThemeBinding Light=#f5f4f0, Dark=#121212}" TextColor="{AppThemeBinding Light=Black, Dark=White}">
                            <Picker.Items>
                                <x:String>System Default</x:String>
                                <x:String>Light</x:String>
                                <x:String>Dark</x:String>
                            </Picker.Items>
                        </Picker>
                    </Grid>

                    <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#e0e0e0, Dark=#333333}" Margin="0,5" />

                    <Label Text="Synchronization" FontSize="16" FontAttributes="Bold" TextColor="{AppThemeBinding Light=Black, Dark=White}" />
                    <Grid ColumnDefinitions="*, Auto">
                        <Label Text="Auto-Refresh Data" VerticalOptions="Center" TextColor="Gray" />
                        <Switch x:Name="AutoRefreshSwitch" Grid.Column="1" Toggled="OnAutoRefreshToggled" OnColor="#2D8F92" />
                    </Grid>
                    <Grid ColumnDefinitions="*, Auto">
                        <Label Text="Refresh Frequency" VerticalOptions="Center" TextColor="Gray" />
                        <Picker x:Name="RefreshFrequencyPicker" Grid.Column="1" WidthRequest="150" SelectedIndexChanged="OnRefreshFrequencyChanged" BackgroundColor="{AppThemeBinding Light=#f5f4f0, Dark=#121212}" TextColor="{AppThemeBinding Light=Black, Dark=White}">
                            <Picker.Items>
                                <x:String>15 Seconds</x:String>
                                <x:String>30 Seconds</x:String>
                                <x:String>1 Minute</x:String>
                                <x:String>5 Minutes</x:String>
                            </Picker.Items>
                        </Picker>
                    </Grid>

                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>

        <Border x:Name="SearchOverlay" Grid.Row="1" IsVisible="False" VerticalOptions="Start" Margin="20,0,20,0" ZIndex="10" BackgroundColor="{AppThemeBinding Light=White, Dark=#1a1a1a}" Stroke="{AppThemeBinding Light=#dedad4, Dark=#333333}" StrokeShape="RoundRectangle 8">
            <Border.Shadow>
                <Shadow Brush="Black" Offset="0,4" Radius="8" Opacity="0.15" />
            </Border.Shadow>
            <VerticalStackLayout>
                <CollectionView x:Name="SearchDropdownList" SelectionMode="Single" SelectionChanged="OnSearchResultSelected">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="15,10">
                                <HorizontalStackLayout Spacing="8" VerticalOptions="Center">

                                    <Label Text="{Binding product_name}" FontSize="15" FontAttributes="Bold" TextColor="{AppThemeBinding Light=Black, Dark=White}" VerticalOptions="Center"/>

                                    <Label Text="{Binding sku}" FontSize="12" TextColor="Gray" VerticalOptions="Center"/>

                                </HorizontalStackLayout>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </Border>

    </Grid>
</ContentPage>